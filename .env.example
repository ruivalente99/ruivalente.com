# Contact Form Configuration
# For development, you can leave these empty and messages will be logged to console

# Resend API Key (get from https://resend.com/api-keys)
# Sign up for free at https://resend.com (100 emails/day free tier)
RESEND_API_KEY=your_resend_api_key_here

# Email addresses
FROM_EMAIL=noreply@yourdomain.com
TO_EMAIL=your-email@example.com

# Note: For production, make sure to:
# 1. Add your domain to Resend
# 2. Verify your sending domain
# 3. Set these environment variables in your hosting platform

# SEO
# Canonical origin. Defaults to https://www.ruivalente.com (the host the Vercel
# project serves; the apex domain redirects to it). Only set this if that changes.
# NEXT_PUBLIC_SITE_URL=https://www.ruivalente.com

# Google Search Console "HTML tag" verification token (the content="..." value).
# Leave unset when verifying through DNS; no meta tag is emitted without it.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
